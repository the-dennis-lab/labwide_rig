            <Expression xsi:type="ipy:PythonTransform">
              <ipy:Script>@returns(bool)
def process(value):
  sumval=value[0]+value[1]
  if sumval &gt; 1:
    chirp_notok=False
  else:
    chirp_notok=True
  return chirp_notok</ipy:Script>
