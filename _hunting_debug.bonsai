            <Expression xsi:type="ipy:PythonTransform">
              <ipy:Name>isNotInside</ipy:Name>
              <ipy:Script>import math
from System import Tuple

@returns(Tuple[str,str,bool])
def process(value):
  zaber=value[0][0]
  zaber_l = int(zaber[0])
  zaber_ax = int(zaber[1])
  intval = int(value[0][1])
  list_of_locs = eval(value[0][2])
  radius=value[0][3]
  loudness_default=value[0][4]
  loudness=value[0][5]
  playabove=value[0][6]
  cricket_l = list_of_locs[intval][0]
  cricket_ax = list_of_locs[intval][1]
  release_val=2**intval
  if playabove:
    chirp_val=9
  else:
    chirp_val=release_val
  dist=math.sqrt((int(cricket_l-zaber_l)*int(cricket_l-zaber_l))+(int(cricket_ax-zaber_ax)*int(cricket_ax-zaber_ax)))
  print(dist)
  if loudness:
    mult = [.3,.3,.36,.4,.42,.44,.45,.47,.48,.5,.51,.53,.54,.54,.54,.54,.54,.54,.54,.54,.54,.54][int(math.floor(dist/20000))]
  else:
    mult=loudness_default
  chirp_str="{}_{:.2f}".format(chirp_val,mult)
  print(chirp_str)

  if dist &lt; radius:
    is_not_inside=False
  else:
    is_not_inside=True
    print('dist is {} radius is {}'.format(dist,radius))

  return Tuple[str,str,bool](chirp_str,str(release_val),is_not_inside)
</ipy:Script>
