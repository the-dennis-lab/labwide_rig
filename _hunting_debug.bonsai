            <Expression xsi:type="ipy:PythonTransform">
              <ipy:Name>takemedianY</ipy:Name>
              <ipy:Script>import math
from System import Tuple
clr.AddReference("OpenCV.Net")
from System import Tuple

@returns(Tuple[int,int])
def process(values):
  value=values[0]
  const=values[1]
  radius=values[2]
  goodvals=[val for val in value if not math.isnan(val)]
  goodsum=math.fsum(goodvals)
  if len(goodvals) &gt; 0:
    goodlen=len(goodvals)
    goodvals.sort()
    medianval=int(goodvals[int(round(goodlen/2))])
    if abs(math.fsum([medianval,-const])) &lt; (const/radius):
      medianval = int(const)
  else:
    medianval=const
  return Tuple[int,int](medianval,len(goodvals))</ipy:Script>
