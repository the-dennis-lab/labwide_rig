      <Expression xsi:type="ipy:PythonTransform">
        <ipy:Name>lockstep_velocity</ipy:Name>
        <ipy:Script>import math
from System import Tuple
clr.AddReference("OpenCV.Net")
from System import Tuple

@returns(int)
def process(value):
  itemval=value[0]
  img=value[1]
  zaberloc=value[2]
  lockstep=zaberloc[0]
  ax3=zaberloc[1]
  intval=value[3]
  width=value[4]

  #make constant depend on zaber
  mult_str=str(img[int(lockstep/100),int(ax3/100)])[1:4]

  if '255' in mult_str:
    constant=172
  elif '0' in mult_str:
    constant=84
  else:
    constant=128

  newval = itemval/(float(width)/256)
  newval = newval-constant
  newval = int(newval*-intval)

  return newval</ipy:Script>
