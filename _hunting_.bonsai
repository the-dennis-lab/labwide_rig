            <Expression xsi:type="ipy:PythonTransform">
              <ipy:Name>get_lsax_values</ipy:Name>
              <ipy:Script>from System import Tuple

@returns(str)
def process(value):
  loc_list=value[0]
  loc_tuples=[]
  for loc in loc_list:
    good=0
    for line_val in value[1]:
      split_vals = line_val.split(',')
      if loc == split_vals[0]:
        good=1
        loc_tuples.append([int(split_vals[1]),int(split_vals[2])])
    if not good:
      loc_tuples.append([0,0])
  return str(loc_tuples)</ipy:Script>
